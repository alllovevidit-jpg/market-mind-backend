# Copy to .env and fill in what you need. Every line is optional.

# True tick-by-tick prices (Fyers). Tokens expire every day, so refresh this each morning.
FYERS_APP_ID=
FYERS_ACCESS_TOKEN=

# Protects the backend. Strongly recommended if it is reachable from anywhere but your own computer.
# The website must then be built with VITE_API_KEY set to the same value.
MARKETMIND_API_KEY=

# Comma separated list of website addresses allowed to talk to the backend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

POLL_OPEN_SECONDS=6
MAX_CLIENTS=100
